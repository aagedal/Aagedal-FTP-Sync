@@ -1,10 +1,31 @@
 import UniformTypeIdentifiers
 
 extension UTType {
-    /// Shared with Aagedal FTP Sync. A bare `.aagedalpeople` item is a directory
-    /// package; ZIP transport uses the distinct `.aagedalpeople.zip` suffix.
+    /// Shared with Aagedal FTP Sync. A bare `.photoagentpeople` item is a directory
+    /// package; ZIP transport uses the distinct `.photoagentpeople.zip` suffix. Legacy extensions remain importable.
     static let aagedalPeopleLibrary = UTType(
         exportedAs: "no.aagedal.people-library",
         conformingTo: .package
     )
 }
+
+/// Public filenames only; internal schema and the shared UTType identity stay unchanged.
+nonisolated enum KnownPeoplePackageNaming {
+    static let directoryExtension = "photoagentpeople"
+    static let archiveSuffix = ".photoagentpeople.zip"
+    private static func matches(_ name: String, suffix: String) -> Bool {
+        name.hasSuffix(suffix) && name.count > suffix.count
+    }
+    static func isDirectoryExportName(_ name: String) -> Bool {
+        matches(name, suffix: "." + directoryExtension)
+    }
+    static func isArchiveExportName(_ name: String) -> Bool {
+        matches(name, suffix: archiveSuffix)
+    }
+    static func isDirectoryImportName(_ name: String) -> Bool {
+        isDirectoryExportName(name) || matches(name, suffix: ".aagedalpeople")
+    }
+    static func isArchiveImportName(_ name: String) -> Bool {
+        isArchiveExportName(name) || matches(name, suffix: ".aagedalpeople.zip")
+    }
+}
